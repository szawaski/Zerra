<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!--<Nullable>enable</Nullable>-->
        <NoWarn>CS8632</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>14.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Zerra\Zerra.csproj" />
        <!-- ExcludeAssets stops xunit.v3's MSBuild tasks (brought in transitively by the test project) from also generating an entry point for this exe -->
        <ProjectReference Include="..\Zerra.Repository.Test\Zerra.Repository.Test.csproj" ExcludeAssets="analyzers;build;buildTransitive" />
    </ItemGroup>

</Project>
