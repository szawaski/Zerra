<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <!--<Nullable>enable</Nullable>-->
        <NoWarn>CS8632</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>15.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Zerra\Zerra.csproj" />
        <!-- ExcludeAssets stops xunit.v3's MSBuild tasks (brought in transitively by the test project) from also generating an entry point for this exe -->
        <ProjectReference Include="..\..\Tests\Zerra.Repository.Test\Zerra.Repository.Test.csproj" ExcludeAssets="analyzers;build;buildTransitive" />
    </ItemGroup>

</Project>
