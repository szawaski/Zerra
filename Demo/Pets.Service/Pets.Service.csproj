<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <!-- No InvariantGlobalization here, Microsoft.Data.SqlClient can't connect in that mode -->
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <EventSourceSupport>false</EventSourceSupport>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MySql.Data" Version="9.7.0" />
        <PackageReference Include="Npgsql" Version="9.0.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Zerra.Repository.MariaDb\Zerra.Repository.MariaDb.csproj" />
        <ProjectReference Include="..\..\Framework\Zerra.Repository.Memory\Zerra.Repository.Memory.csproj" />
        <ProjectReference Include="..\..\Framework\Zerra.Repository.MsSql\Zerra.Repository.MsSql.csproj" />
        <ProjectReference Include="..\..\Framework\Zerra.Repository.MySql\Zerra.Repository.MySql.csproj" />
        <ProjectReference Include="..\..\Framework\Zerra.Repository.PostgreSql\Zerra.Repository.PostgreSql.csproj" />
        <ProjectReference Include="..\Pets.Domain\Pets.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Zerra.SourceGeneration\Zerra.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Referenced projects' .pdb files are useless in an AOT publish (their code is compiled into the exe) -->
    <Target Name="RemoveIlPdbsFromAotPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

</Project>
