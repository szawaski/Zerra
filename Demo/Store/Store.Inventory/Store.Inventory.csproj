<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <!-- Confluent.Kafka is not trim annotated, so its trim warnings roll up into one IL2104. The reflection
             behind them is in a code path this demo never runs, Kafka's AWS OAuth handler. The SDK never rolls up
             the project's own assembly or its project references, so this only silences NuGet packages, never Zerra
             or the Store projects. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.CQRS.Kafka\Zerra.CQRS.Kafka.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.CQRS.RabbitMQ\Zerra.CQRS.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.Memory\Zerra.Repository.Memory.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.MySql\Zerra.Repository.MySql.csproj" />
        <ProjectReference Include="..\Store.Common\Store.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.SourceGeneration\Zerra.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
</Project>
