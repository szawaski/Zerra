<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <!-- Confluent.Kafka, MySql.Data and the System.Configuration.ConfigurationManager it drags in are not trim
             annotated, so each rolls its trim warnings up into one IL2104. The reflection behind them is in code paths
             this demo never runs: Kafka's AWS OAuth handler, MySQL's OCI and authentication plugin loaders, and
             app.config section binding. The SDK never rolls up the project's own assembly or its project references,
             so this only silences NuGet packages, never Zerra or the Store projects. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.CQRS.Kafka\Zerra.CQRS.Kafka.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.Memory\Zerra.Repository.Memory.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.MySql\Zerra.Repository.MySql.csproj" />
        <ProjectReference Include="..\Store.Common\Store.Common.csproj" />
        <ProjectReference Include="..\Store.Inventory.Domain\Store.Inventory.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.SourceGeneration\Zerra.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
</Project>
