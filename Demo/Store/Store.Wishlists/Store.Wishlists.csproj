<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <!-- MongoDB.Driver and MongoDB.Bson are not trim annotated, so their warnings roll up into one IL2104 and IL3053 apiece:
             the BSON class maps and serializers the driver creates by reflection. The store reads and writes BsonDocument only, and
             Zerra.Repository.MongoDB registers the serializers the driver itself needs. The SDK never rolls up the project's own
             assembly or its project references, so this only silences NuGet packages, never Zerra or the Store projects. -->
        <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.Memory\Zerra.Repository.Memory.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.MongoDB\Zerra.Repository.MongoDB.csproj" />
        <ProjectReference Include="..\Store.Common\Store.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.SourceGeneration\Zerra.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
