<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <!-- RabbitMQ.Client 6.x is a netstandard2.0 library with no trim annotations, so its one trim warning rolls up
             into an IL2104: EventSource.WriteEvent boxing an exception detail on the error logging path. RabbitMQ.Client
             7.x is marked trimmable, but its API is async-only and would be a rewrite of Zerra.CQRS.RabbitMQ. The SDK
             never rolls up the project's own assembly or its project references, so this only silences NuGet packages,
             never Zerra or the Store projects. -->
        <NoWarn>$(NoWarn);IL2104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.Web\Zerra.Web.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.CQRS.RabbitMQ\Zerra.CQRS.RabbitMQ.csproj" />
        <ProjectReference Include="..\..\..\Framework\Zerra.Repository.Memory\Zerra.Repository.Memory.csproj" />
        <ProjectReference Include="..\Store.Common\Store.Common.csproj" />
        <ProjectReference Include="..\Store.Orders.Domain\Store.Orders.Domain.csproj" />
        <ProjectReference Include="..\Store.Shipping.Domain\Store.Shipping.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Framework\Zerra.SourceGeneration\Zerra.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
