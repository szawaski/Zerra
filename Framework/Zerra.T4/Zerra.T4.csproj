<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>15.0</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <Version>6.0.0-rc.3</Version>
        <Authors>Steven Zawaski</Authors>
        <Company>KaKush LLC</Company>
        <Copyright>KaKush LLC</Copyright>
        <Product>Zerra Framework</Product>
        <RepositoryUrl>https://github.com/szawaski/Zerra</RepositoryUrl>
        <Description>T4 helpers that generate Zerra.Repository models from an existing SQL Server database.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
    </ItemGroup>

    <!-- The pre-built binary T4 templates point at, committed so it can be used without building -->
    <Target Name="CopyToBinaries" AfterTargets="Build">
        <PropertyGroup>
            <BinariesPath>$(MSBuildThisFileDirectory)Binaries\</BinariesPath>
        </PropertyGroup>
        <ItemGroup>
            <BinariesToCopy Include="$(OutputPath)Zerra.T4.dll" />
            <BinariesToCopy Include="$(OutputPath)Zerra.T4.pdb" />
            <BinariesToCopy Include="$(OutputPath)Zerra.T4.xml" />
        </ItemGroup>
        <Copy SourceFiles="@(BinariesToCopy)" DestinationFolder="$(BinariesPath)" SkipUnchangedFiles="true" />
    </Target>

</Project>
